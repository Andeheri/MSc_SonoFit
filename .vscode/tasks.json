{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build LaTeX",
      "type": "shell",
      "command": "latexmk -pdf -interaction=nonstopmode -cd -auxdir=thesis/_out/auxfiles -outdir=thesis/_out/output thesis/main.tex",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Clean and Build LaTeX",
      "type": "shell",
      "command": "latexmk -C >/dev/null 2>&1 || true && latexmk -pdf -interaction=nonstopmode -cd -auxdir=thesis/_out/auxfiles -outdir=thesis/_out/output thesis/main.tex",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
